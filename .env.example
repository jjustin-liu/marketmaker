# Copy to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.
# Usage:  source .env.local && python -m src.cli live

# --- Binance Spot Testnet credentials (optional) ---
# If both are set, the CLI uses the testnet engine.
# If unset, the CLI falls back to the in-process paper simulator.
export BINANCE_API_KEY=
export BINANCE_API_SECRET=
export BINANCE_TESTNET=1                  # 0 = mainnet, do NOT flip without intent

# --- Redis ---
export REDIS_HOST=localhost
export REDIS_PORT=6379

# --- Risk caps (paper + testnet) ---
export MM_MAX_POSITION=0.01               # BTC
export MM_MAX_DRAWDOWN=50                 # USD from peak PnL

# --- Loop + model ---
export MM_POLL_SECONDS=0.1
export MM_FILL_MODEL_PATH=data/models/fill_prob.joblib
export MM_SYMBOL=BTCUSDT
